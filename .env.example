# Firebase web config for the ADMIN CONSOLE project — a separate Firebase project from
# the player app, deliberately (see quiz-server's backend-architecture notes). Get these
# values from Firebase Console → this project → Project settings → General → "Your apps"
# → Web app. If no web app exists on the admin project yet, add one there first (no need
# to install the Firebase SDK again, just register the app to get this config block).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# quiz-server base URL
PUBLIC_API_BASE_URL=http://localhost:8080
